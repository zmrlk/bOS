# ============================================
# bOS — .gitignore
# Only excludes internal business docs and runtime artifacts.
# All product files ship to users.
# ============================================

# ─────────────────────────────────────────────
# INTERNAL — Business docs (not part of product)
# ─────────────────────────────────────────────
gumroad/

# ─────────────────────────────────────────────
# RUNTIME — Generated during usage, not part of product
# ─────────────────────────────────────────────
profile.md
.secrets/
state/archive/
state/.backup/
state/n8n-templates/

# Runtime dotfiles written by hooks and skills during a session — per-user
# state that must never ship in the distribution. Covers .last-message,
# .setup-progress.md, .engage*, .morning-*, .evening-*, .micro-*, .working.md,
# .pre-morning.md, .maintenance-log.md and anything added later.
# state/.gitkeep is the one dotfile that IS tracked (keeps the dir alive).
state/.*
!state/.gitkeep
state/ping.md
state/handoff.md
state/context-bus.jsonl
.claude/logs/

# ─────────────────────────────────────────────
# EXPORTS & BACKUPS — User-generated
# ─────────────────────────────────────────────
bos-export-*.md

# ─────────────────────────────────────────────
# TEMP / BUILD
# ─────────────────────────────────────────────
.trash-cross-platform/
node_modules/
state/.pre-morning.md

# ─────────────────────────────────────────────
# OS ARTIFACTS
# ─────────────────────────────────────────────
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
.memsearch/
